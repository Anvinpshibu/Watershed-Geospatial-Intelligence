{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watershed Geospatial Intelligence",
  "version": "0.1.0",
  "identifier": "com.dolr.watershed.intelligence",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watershed Geospatial Intelligence Platform (DoLR)",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
